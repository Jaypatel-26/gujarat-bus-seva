// 🚌 Gujarat Bus Seva — Prisma schema (PostgreSQL for Render)
// For local dev without Postgres, run `npm run setup:local`
// which generates an identical SQLite schema (prisma/schema.local.prisma).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  mobile        String    @unique
  email         String?
  conductor_id  String?
  password_hash String?
  password_plain String? // sirf admin ko conductors ka password dikhane ke liye (demo app)
  role          String    @default("PASSENGER") // PASSENGER | ADMIN | DRIVER
  created_at    DateTime  @default(now())
  bookings      Booking[]
  reviews       Review[]
  drivenTrips   Trip[]

  @@map("users")
}

model City {
  id         Int     @id // fixed id from seed (1..41)
  name       String  @unique
  state      String  @default("Gujarat")
  lat        Float
  lng        Float
  routesFrom Route[] @relation("FromCity")
  routesTo   Route[] @relation("ToCity")

  @@map("cities")
}

model Route {
  id           Int      @id @default(autoincrement())
  from_city_id Int
  to_city_id   Int
  distance_km  Float
  base_fare    Float
  stops_json   String?  // admin-defined intermediate stations: [{name, arrOffset, depOffset}] (minutes from trip departure)
  fromCity     City     @relation("FromCity", fields: [from_city_id], references: [id])
  toCity       City     @relation("ToCity", fields: [to_city_id], references: [id])
  trips        Trip[]
  reviews      Review[]

  @@unique([from_city_id, to_city_id])
  @@map("routes")
}

model Bus {
  id            Int    @id @default(autoincrement())
  bus_number    String @unique
  operator_name String
  type          String // AC_SEATER | NON_AC_SEATER | SEMI_SLEEPER | AC_SLEEPER
  total_seats   Int
  seats         Seat[]
  trips         Trip[]

  @@map("buses")
}

model Trip {
  id             Int           @id @default(autoincrement())
  route_id       Int
  bus_id         Int
  driver_id      Int?
  departure_time DateTime
  arrival_time   DateTime
  date           DateTime // service day (00:00)
  status         String        @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  fare           Float // per-seat fare for this trip
  route          Route         @relation(fields: [route_id], references: [id])
  bus            Bus           @relation(fields: [bus_id], references: [id])
  driver         User?         @relation(fields: [driver_id], references: [id])
  bookings       Booking[]
  liveLocation   LiveLocation?
  reviews        Review[]

  @@index([route_id, date])
  @@map("trips")
}

model Seat {
  id          Int           @id @default(autoincrement())
  bus_id      Int
  seat_number String
  seat_type   String        @default("SEAT") // SEAT | BERTH
  deck        String        @default("LOWER") // LOWER | UPPER
  row         Int
  col         Int
  bus         Bus           @relation(fields: [bus_id], references: [id])
  bookingSeat BookingSeat[]

  @@map("seats")
}

model Booking {
  id             Int                @id @default(autoincrement())
  pnr            String             @unique
  user_id        Int
  trip_id        Int
  total_fare     Float
  status         String             @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  qr_code        String?
  contact_email  String?
  contact_mobile String?
  created_at     DateTime           @default(now())
  user           User               @relation(fields: [user_id], references: [id])
  trip           Trip               @relation(fields: [trip_id], references: [id])
  seats          BookingSeat[]
  passengers     BookingPassenger[]
  payment        Payment?

  @@map("bookings")
}

model BookingSeat {
  id         Int     @id @default(autoincrement())
  booking_id Int
  seat_id    Int
  booking    Booking @relation(fields: [booking_id], references: [id])
  seat       Seat    @relation(fields: [seat_id], references: [id])

  @@unique([booking_id, seat_id])
  @@index([seat_id])
  @@map("booking_seats")
}

model BookingPassenger {
  id         Int     @id @default(autoincrement())
  booking_id Int
  seat_id    Int?
  name       String
  age        Int
  gender     String // M | F | O
  booking    Booking @relation(fields: [booking_id], references: [id])

  @@map("booking_passengers")
}

model LiveLocation {
  id         Int      @id @default(autoincrement())
  trip_id    Int      @unique
  latitude   Float
  longitude  Float
  speed      Float    @default(0)
  progress   Float    @default(0)
  updated_at DateTime @updatedAt
  trip       Trip     @relation(fields: [trip_id], references: [id])

  @@map("live_locations")
}

model Payment {
  id             Int      @id @default(autoincrement())
  booking_id     Int      @unique
  amount         Float
  method         String   @default("RAZORPAY") // RAZORPAY | MOCK
  status         String   @default("PENDING") // PENDING | SUCCESS | FAILED | REFUNDED
  transaction_id String?
  created_at     DateTime @default(now())
  booking        Booking  @relation(fields: [booking_id], references: [id])

  @@map("payments")
}

model Review {
  id         Int      @id @default(autoincrement())
  user_id    Int
  trip_id    Int?
  route_id   Int?
  rating     Int // 1..5
  comment    String?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
  trip       Trip?    @relation(fields: [trip_id], references: [id])
  route      Route?   @relation(fields: [route_id], references: [id])

  @@map("reviews")
}
