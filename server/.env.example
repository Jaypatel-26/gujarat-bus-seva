# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# ---- Database ----
# On Render: paste the "Internal Database URL" from your Render PostgreSQL instance.
# Example: postgresql://user:pass@dpg-xxxx-a/gbs_db
DATABASE_URL=postgresql://user:password@localhost:5432/gbs_db

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- Razorpay (leave empty to run in DEMO payment mode) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Live tracking simulation speed (1 = realtime; 100 → 5h trip plays out in ~3 min) ----
SIM_SPEED=100

# ---- SMS OTP provider ----
# Without Twilio creds, OTP is returned in the API response as `devOtp` (demo mode).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
